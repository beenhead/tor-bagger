# Copy to .env and fill in. Used by docker compose (this directory).
#   cp .env.example .env
# Generate secrets with: openssl rand -hex 32

# --- Required ---

# Signs JWTs AND logbook exports. Keep it stable once set, or existing exports
# stop validating. Do not reuse the dev value in production.
SECRET_KEY=

# Database password for the postgres container. Special characters are safe
# here — the backend percent-encodes this when it builds the connection URL.
# Note that a "$" still needs doubling ("$$") because Compose interpolates it.
POSTGRES_PASSWORD=

# Public base URL of the web frontend — password-reset links point here.
# Must match the real URL exactly, including the https:// scheme. Cloudflare
# Tunnel serves the site over HTTPS even though the origin here is plain HTTP.
# Production: https://torbagger.beanhead.co.uk
# Local dev:  http://localhost:5500
WEB_BASE_URL=https://torbagger.beanhead.co.uk


# --- Optional ---

# Where the web container is published. The default binds to loopback only,
# which is what you want behind Cloudflare Tunnel (it connects outbound and
# reaches the site at http://localhost:80 — no inbound ports needed).
# Set WEB_BIND=0.0.0.0 only if exposing this host to the network directly.
# For local development, WEB_PORT=5500.
WEB_BIND=127.0.0.1
WEB_PORT=80

POSTGRES_USER=tor_bagger
POSTGRES_DB=tor_bagger

# Comma-separated origins allowed to call the API cross-origin. Leave empty in
# production: the frontend is same-origin behind nginx at /api/, so it needs no
# entry here. The dev overlay sets "*" automatically.
CORS_ORIGINS=

# Password-reset email. Without a key, reset links print to the backend log.
RESEND_API_KEY=
RESEND_FROM=Tor Bagger <onboarding@resend.dev>
