# Copy to .env and fill in. Used by docker compose (this directory).
#   cp .env.example .env
# Generate secrets with: openssl rand -hex 32

# --- Required ---

# Signs JWTs AND logbook exports. Keep it stable once set, or existing exports
# stop validating. Do not reuse the dev value in production.
SECRET_KEY=

# Database password for the postgres container.
POSTGRES_PASSWORD=

# Public base URL of the web frontend — password-reset links point here.
# Production: https://beanhead.co.uk
# Local dev:  http://localhost:5500
WEB_BASE_URL=https://beanhead.co.uk

# --- Optional ---

# Host port the site is served on. 80 in production; 5500 for local dev.
WEB_PORT=80

POSTGRES_USER=tor_bagger
POSTGRES_DB=tor_bagger

# Comma-separated origins allowed to call the API cross-origin. Leave empty in
# production: the frontend is same-origin behind nginx at /api/, so it needs no
# entry here. The dev overlay sets "*" automatically.
CORS_ORIGINS=

# Password-reset email. Without a key, reset links print to the backend log.
RESEND_API_KEY=
RESEND_FROM=Tor Bagger <onboarding@resend.dev>
